		<Item class="ModuleScript" referent="RBXC582F47F6CB2477EA6F583A872C6C130">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- English display names; the first three tiers follow the latest economy specification.
local names = {
	"Pudding", "Custard", "Strawberry Jelly", "Brownie", "Cookie", "Donut", "Egg Tart", "Cream Puff",
	"Macaron", "Salt Bread", "Cake", "Financier", "Canele", "Madeleine", "Souffle",
	"Parfait", "Roll Cake", "Crepe", "Shaved Ice", "Eclair", "Tiramisu", "Mont Blanc",
	"Panna Cotta", "Mille-Feuille", "Handmade Candy", "Pastel Potion", "Royal Tea Pudding",
	"Macaron Tower", "Moonlight Sugar Castle", "Parfait Dragon",
}
local tiers = {}
for tier, name in ipairs(names) do
	tiers[tier] = table.freeze({
		Tier = tier,
		Name = name,
		MergeCount = 3,
		NextTier = tier < #names and tier + 1 or nil,
		PuddingEquivalent = 3 ^ (tier - 1),
	})
end
return table.freeze(tiers)
]]></ProtectedString>
				<string name="ScriptGuid">{2A34AF40-FBA7-40DB-BD5B-3FBCD4ACC7CC}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">DessertCatalog</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">77ef6712a8ce0ba90adfea04000018a8</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXD620BAAB10724D1596A9575E6D44DA2E">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Shared by the fresh map generator and the edit-mode layout migration.
-- Sixty visible dessert positions: six rows by five columns on each side.
local Layout = { Radius = 150, Width = 96, Depth = 120, IslandDiameter = 460 }
local pink = Color3.fromRGB(255,193,218)
local lavender = Color3.fromRGB(211,198,248)
local mint = Color3.fromRGB(185,235,211)
local cream = Color3.fromRGB(255,248,235)
local cocoa = Color3.fromRGB(112,76,91)
local function part(parent,name,size,cf,color,solid)
	local p=Instance.new("Part")
	p.Name,p.Size,p.CFrame,p.Color=name,size,cf,color
	p.Anchored,p.CanCollide,p.CanTouch=true,solid~=false,false
	p.Material=Enum.Material.SmoothPlastic
	p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
	p.Parent=parent
	return p
end
local function model(parent,name)
	local m=Instance.new("Model"); m.Name,m.Parent=name,parent; return m
end
local function label(p,name,text,width)
	local gui=Instance.new("BillboardGui")
	gui.Name,gui.Size,gui.StudsOffset,gui.MaxDistance=name,UDim2.new(width or 8,0,1.5,0),Vector3.new(0,2.5,0),55
	gui.Adornee,gui.Parent=p,p
	local t=Instance.new("TextLabel")
	t.Name,t.Size,t.BackgroundTransparency,t.TextScaled="CollectionLabel",UDim2.fromScale(1,1),1,true
	t.Text,t.Font,t.TextColor3=text,Enum.Font.GothamBold,cocoa; t.Parent=gui
	return gui
end
function Layout.BuildDessertSlots(plot)
	local cf=plot:GetPivot()
	local pads=plot:FindFirstChild("PetSpawnPads") or model(plot,"PetSpawnPads")
	pads:ClearAllChildren()
	local old=plot:FindFirstChild("PetPadFrames")
	if old then old:Destroy() end
	local frames=model(plot,"PetPadFrames")
	for sideIndex,side in ipairs({-1,1}) do
		for row=1,6 do for column=1,5 do
			local slot=(sideIndex-1)*30+(row-1)*5+column
			local x=side*(8+(column-1)*7.8)
			local z=4+(row-1)*9.2
			local frame=part(frames,"PadFrame"..slot,Vector3.new(6,.24,6),cf*CFrame.new(x,2.37,z),Color3.fromRGB(181,169,190))
			local pad=part(pads,"PetPad"..slot,Vector3.new(5.5,.12,5.5),cf*CFrame.new(x,2.55,z),mint)
			pad.TopSurface,frame.TopSurface=Enum.SurfaceType.Studs,Enum.SurfaceType.Studs
			pad:SetAttribute("SlotIndex",slot)
			pad:SetAttribute("PlotId",plot:GetAttribute("PlotId"))
			pad:SetAttribute("Side",side<0 and "Left" or "Right")
			pad:SetAttribute("Row",row); pad:SetAttribute("Column",column)
			pad:SetAttribute("DropLaneZ",z)
		end end
	end
	plot:SetAttribute("DessertCapacity",60)
end
function Layout.Apply(island)
	assert(not island:GetAttribute("CleanPlotLayoutVersion"),"Clean layout already applied")
	local hub=island.CentralHub
	local center=hub.CentralShop:GetPivot().Position
	local template=game.ServerStorage:FindFirstChild("CentralCafeTemplate")
	if not hub.CentralShop:FindFirstChild("CenterAnchor") then
		if not template then
			template=model(game.ServerStorage,"CentralCafeTemplate")
			hub.CentralShop.Parent=template
			if hub:FindFirstChild("GiantPudding") then hub.GiantPudding.Parent=template end
		else
			hub.CentralShop:Destroy()
			if hub:FindFirstChild("GiantPudding") then hub.GiantPudding:Destroy() end
		end
		local anchorModel=model(hub,"CentralShop")
		local anchor=part(anchorModel,"CenterAnchor",Vector3.new(.2,.2,.2),CFrame.new(center),cream,false)
		anchor.Transparency,anchor.CanQuery=1,false; anchorModel.PrimaryPart=anchor
		if not hub:FindFirstChild("CentralDisplay") then model(hub,"CentralDisplay") end
	end
	-- Expand the circular island once, without scaling the cafes or tree meshes.
	local ground=island.FloatingIsland.MintIcingGround
	local factor=Layout.IslandDiameter/ground.Size.Y
	for _,p in ipairs(island.FloatingIsland:GetDescendants()) do
		if p:IsA("BasePart") then
			local pos=p.Position; p.CFrame=CFrame.new(pos.X*factor,pos.Y,pos.Z*factor)*p.CFrame.Rotation
			if p.Shape==Enum.PartType.Cylinder then p.Size=Vector3.new(p.Size.X,p.Size.Y*factor,p.Size.Z*factor)
			else p.Size=Vector3.new(p.Size.X*factor,p.Size.Y,p.Size.Z*factor) end
		end
	end
	for _,groupName in ipairs({"CandyGarden","SakuraGarden"}) do
		local garden=island:FindFirstChild(groupName)
		if garden then for _,item in ipairs(garden:GetChildren()) do
			if item:IsA("PVInstance") then
				local old=item:GetPivot(); local radial=Vector3.new(old.X,0,old.Z)
				if radial.Magnitude>100 then item:PivotTo(old+radial.Unit*(radial.Magnitude*(factor-1))) end
			end
		end end
	end
	if island:FindFirstChild("SugarPaths") then island.SugarPaths:ClearAllChildren() end
	local archive=Instance.new("Folder"); archive.Name,archive.Parent="PreviousPlotDecor",game.ServerStorage
	for i=1,6 do
		local plot=island.PlayerPlots["Plot"..i]
		local old=plot:GetPivot(); local angle=(i-1)*math.pi/3
		local position=Vector3.new(center.X+math.sin(angle)*Layout.Radius,old.Y,center.Z+math.cos(angle)*Layout.Radius)
		local cf=CFrame.lookAt(position,Vector3.new(center.X,old.Y,center.Z))
		plot:PivotTo(cf)
		local area=plot:FindFirstChild("PersonalShopArea") or model(plot,"PersonalShopArea")
		local cafe=area:FindFirstChild("DessertCafe")
		if not cafe then cafe=template:Clone(); cafe.Name,cafe.Parent="DessertCafe",area; cafe.CentralShop.Name="CafeBuilding" end
		local owner=cafe:FindFirstChild("OwnerSign",true)
		local box,size=cafe:GetBoundingBox()
		cafe:PivotTo(cf*CFrame.new(0,.15+size.Y/2,-42)*box:ToObjectSpace(cafe:GetPivot()))
		if not owner then owner=label(cafe.CafeBuilding.Roof,"OwnerSign","Available Cafe",18); owner.CollectionLabel.Name="OwnerLabel" end
		owner.StudsOffset=Vector3.new(0,15,0)
		for _,child in ipairs(plot:GetChildren()) do
			if child~=area then
				if child.Name=="GardenDecor" or child.Name:match("DisplayMascot") then child.Parent=archive
				else child:Destroy() end
			end
		end
		for _,child in ipairs(area:GetChildren()) do if child~=cafe then child:Destroy() end end
		local function at(x,y,z) return cf*CFrame.new(x,y,z) end
		local function p(parent,name,size,x,y,z,color,solid) return part(parent,name,size,at(x,y,z),color,solid) end
		-- One uninterrupted base and four low edge trims. ClassicPlotStyle finishes its surface.
		local floor=p(plot,"PlotFloor",Vector3.new(96,1,120),0,-.35,0,cream)
		plot.PrimaryPart=floor
		-- Keep the pivot at the original gameplay origin rather than the floor's center.
		floor.PivotOffset=CFrame.new(0,.35,0)
		for _,x in ipairs({-47.5,47.5}) do p(plot,"SideFence",Vector3.new(1,.6,120),x,.35,0,i%2==0 and lavender or pink) end
		p(plot,"BackFence",Vector3.new(94,.6,1),0,.35,59.5,lavender)
		p(plot,"FrontTrim",Vector3.new(94,.25,1),0,.27,-59.5,pink)
		p(plot,"Entrance",Vector3.new(10,.1,5),30,.2,-57,mint)
		p(plot,"PlotSpawn",Vector3.new(8,.1,6),30,.2,-51,mint)
		local board=p(plot,"MergeBoard",Vector3.new(18,.6,18),-27,.45,-4,lavender)
		board:SetAttribute("RequiredCount",3); label(board,"MergeSign","Merge 3 into 1",10)
		local cells=model(plot,"MergeCells")
		for row=1,3 do for col=1,3 do
			p(cells,"Cell"..((row-1)*3+col),Vector3.new(4.8,.05,4.8),-27+(col-2)*5.3,.78,-4+(row-2)*5.3,cream,false)
		end end
		local buttons=model(plot,"PurchaseButtons")
		for n,count in ipairs({1,5,25,100}) do
			local x=n<=2 and -25 or 25; local z=(n==1 or n==3) and -32 or -22
			local pad=p(buttons,"Buy"..count,Vector3.new(9,.3,6),x,.3,z,lavender)
			label(pad,"BuySign","Buy "..count.." ($"..tostring(count*5)..")",9)
		end
		label(p(area,"CollectIncome",Vector3.new(9,.3,6),-25,.3,-47,mint),"IncomeSign","Collect Earnings",9)
		local crate=p(area,"DessertCrate",Vector3.new(9,.3,6),25,.3,-47,pink)
		crate:SetAttribute("GameplayConnected",false); label(crate,"CrateSign","Dessert Crate - Coming Soon",10)
		-- Two broad meadows, each holding six rows of five dessert pedestals.
		local beds=model(plot,"ProductionBeds")
		for _,side in ipairs({-1,1}) do
			p(beds,side<0 and "LeftMeadow" or "RightMeadow",Vector3.new(40,2,56),side*24,1.25,27,mint)
			p(beds,"MeadowStep",Vector3.new(40,1,3),side*24,.65,-2,cream)
		end
		Layout.BuildDessertSlots(plot)
		local belts=model(plot,"Conveyors")
		local main=p(belts,"MainBelt",Vector3.new(8,.25,74),0,.4,18,Color3.fromRGB(175,159,188))
		main:SetAttribute("FlowDirection","TowardCafe")
		-- Wide bridges make both meadows accessible; rolling goods pass underneath.
		for _,z in ipairs({0,26,52}) do p(belts,"WalkwayBridge",Vector3.new(12,.3,4),0,2.1,z,cream) end
		local collector=p(belts,"Collector",Vector3.new(8,.8,3),0,.6,-20,mint)
		label(collector,"CollectorSign","Collect $0",9)
		plot:SetAttribute("LayoutStyle","CleanTycoonBase")
		plot:SetAttribute("CollectorZ",-20)
		plot:SetAttribute("ProductionBedCount",2)
		plot:SetAttribute("OwnerUserId",0)
		local pathCenter=(Vector3.new(center.X,position.Y,center.Z)+at(30,0,-60).Position)/2
		local endpoint=at(30,0,-60).Position
		part(island.SugarPaths,"CreamPath",Vector3.new(14,.3,(endpoint-Vector3.new(center.X,position.Y,center.Z)).Magnitude),CFrame.lookAt(pathCenter,endpoint)*CFrame.new(0,-.55,0),cream)
	end
	island:SetAttribute("CleanPlotLayoutVersion",1)
	island:SetAttribute("ConveyorLayoutVersion",2)
	island:SetAttribute("MapVersion","8.0.0")
	island:SetAttribute("PlotRadius",Layout.Radius)
	print("[CleanPlots] Built six 96x120 bases, side merge boards, open meadows and wide conveyors")
end
return Layout
]]></ProtectedString>
				<string name="ScriptGuid">{4B7E26F0-925C-4EC4-884E-92B94810D72D}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">TycoonPlotLayout</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">77ef6712a8ce0ba90adfea0400004ae5</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX402AC81C37144AA4ADEB6751737A409B">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Large ground surfaces and pocket gardens; no new gameplay scripts in imported props.
local Landscape={}
local cream=Color3.fromRGB(249,239,221)
local pink=Color3.fromRGB(245,190,211)
local lavender=Color3.fromRGB(204,188,228)
local grass=Color3.fromRGB(180,238,191)
local function group(parent,name)
	local m=Instance.new("Model"); m.Name,m.Parent=name,parent; return m
end
local function part(parent,name,size,cf,color,material,shape,solid)
	local p=Instance.new("Part")
	p.Name,p.Size,p.CFrame,p.Color=name,size,cf,color
	p.Material=material or Enum.Material.SmoothPlastic
	p.Shape=shape or Enum.PartType.Block
	p.Anchored,p.CanCollide,p.CanTouch=true,solid==true,false
	p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
	p.Parent=parent; return p
end
local function place(source,parent,name,cf,maxSize,recolor)
	if not source then return end
	local m=group(nil,name)
	local copy=source:Clone(); copy.Parent=m
	local box,size=m:GetBoundingBox()
	m:ScaleTo(m:GetScale()*maxSize/math.max(size.X,size.Y,size.Z))
	box,size=m:GetBoundingBox()
	m:PivotTo(cf*CFrame.new(0,size.Y/2,0)*box:ToObjectSpace(m:GetPivot()))
	for _,p in ipairs(m:GetDescendants()) do
		assert(not p:IsA("LuaSourceContainer"),"Imported decoration contains code")
		if p:IsA("BasePart") then
			p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery=true,false,false,false
			if recolor then recolor(p) end
		elseif p:IsA("Light") then p.Color=Color3.fromRGB(255,229,196); p.Brightness=.35; p.Range=8
		elseif p:IsA("Beam") then p.Enabled=false end
	end
	m:SetAttribute("DecorationOnly",true)
	m.Parent=parent; return m,size
end
local function solidTint(p,color)
	if p:IsA("MeshPart") then p.TextureID="" end
	for _,d in ipairs(p:GetChildren()) do
		if d:IsA("SpecialMesh") then d.TextureId=""
		elseif d:IsA("SurfaceAppearance") or d:IsA("Decal") or d:IsA("Texture") then d:Destroy() end
	end
	p.Color=color; p.Material=Enum.Material.SmoothPlastic
end
function Landscape.Apply(island)
	assert(not island:GetAttribute("LandscapeVersion"),"Landscape already applied")
	local storage=game.ServerStorage
	local assets=storage:FindFirstChild("FreeEnvironmentAssets")
	local function asset(name) return assets and assets:FindFirstChild(name) end
	local meadow=asset("MeadowPack")
	local grassMesh=meadow and meadow:FindFirstChild("Grass",true)
	local rockMesh=meadow and meadow:FindFirstChild("Rock",true)
	local terrainTop=meadow and meadow:FindFirstChild("Terrain Top",true)
	local nature=asset("NaturePack")
	local roundRock=nature and nature:FindFirstChild("Meshes/lowpolypack_Icosphere",true)
	local world=group(island,"Landscape")
	local ground=island.FloatingIsland.MintIcingGround
	ground.Color,ground.Material=grass,Enum.Material.Grass
	for _,p in ipairs(island.FloatingIsland:GetChildren()) do
		if p.Name=="ScallopedIcing" then p.Color=grass; p.Material=Enum.Material.Grass end
	end
	island.FloatingIsland.PinkCakeLayer.Material=Enum.Material.Sandstone
	island.FloatingIsland.PinkCakeLayer.Color=Color3.fromRGB(227,183,195)
	island.FloatingIsland.LavenderCakeLayer.Material=Enum.Material.Slate
	island.FloatingIsland.LavenderCakeLayer.Color=Color3.fromRGB(197,181,207)
	for _,path in ipairs(island.SugarPaths:GetChildren()) do
		path.Material,path.Color=Enum.Material.Limestone,cream
		for _,side in ipairs({-1,1}) do
			part(world,"PathEdging",Vector3.new(1,.2,path.Size.Z),path.CFrame*CFrame.new(side*(path.Size.X/2+.6),.12,0),Color3.fromRGB(219,207,195),Enum.Material.Slate)
		end
	end
	-- Sculpted ellipsoid hills sit only between plots; the central display remains empty.
	local center=island.CentralHub.CentralShop:GetPivot().Position
	local gardens=group(world,"PocketGardens")
	for i=1,6 do
		local angle=(i-.5)*math.pi/3
		local origin=Vector3.new(center.X+math.sin(angle)*160,0,center.Z+math.cos(angle)*160)
		local cf=CFrame.new(origin)*CFrame.Angles(0,angle,0)
		local garden=group(gardens,"Garden"..i)
		local hill=part(garden,"SoftGrassHill",Vector3.new(42,10,46),cf*CFrame.new(0,-3,0),grass,Enum.Material.Grass,Enum.PartType.Ball,true)
		hill:SetAttribute("LandscapeGround",true)
		part(garden,"SmallGrassHill",Vector3.new(26,6,25),cf*CFrame.new(5,-1.8,8),Color3.fromRGB(219,240,210),Enum.Material.Grass,Enum.PartType.Ball,true)
		place(storage:FindFirstChild("FreeSakuraTemplate"),garden,"BlossomTree",cf*CFrame.new(0,2,0),18)
		-- A low-poly ground mesh rounds out the small garden's shape.
		place(terrainTop,garden,"LowPolyGrassBank",cf*CFrame.new(-3,-1.2,-4),24,function(p) solidTint(p,grass) end)
		for n=1,5 do
			local a=n*math.pi*2/5
			local rock=place(n%2==0 and rockMesh or roundRock,garden,"PastelRock",cf*CFrame.new(math.sin(a)*18,0,math.cos(a)*17),3+n%3,function(p) solidTint(p,n%2==0 and lavender or cream) end)
			if rock then rock:SetAttribute("SourceAssetId",n%2==0 and 18723685255 or 14299404156) end
			place(storage:FindFirstChild("FreeFlowerTemplate"),garden,"FlowerCluster",cf*CFrame.new(math.sin(a)*14,1.1,math.cos(a)*13),4)
		end
		place(storage:FindFirstChild("FreeBenchTemplate"),garden,"GardenBench",cf*CFrame.new(0,0,-24),9,function(p) p.Material=Enum.Material.WoodPlanks; p.Color=cream end)
	end
	for i=1,6 do
		local plot=island.PlayerPlots["Plot"..i]; local cf=plot:GetPivot()
		local decor=group(plot,"CafeGardenDecor"); decor:SetAttribute("PlotId",i)
		local function at(x,y,z) return cf*CFrame.new(x,y,z) end
		plot.PlotFloor.Material,plot.PlotFloor.Color=Enum.Material.Limestone,cream
		for _,p in ipairs(plot.ProductionBeds:GetChildren()) do
			if p.Name:match("Meadow$") then p.Material,p.Color=Enum.Material.Grass,Color3.fromRGB(190,245,205) end
		end
		-- Broad material zones define the cafe, pedestrian forecourt and grassy field.
		part(decor,"BakeryTerrace",Vector3.new(32,.08,27),at(0,.19,-42),Color3.fromRGB(239,211,205),Enum.Material.WoodPlanks,nil,true)
		part(decor,"TeaPatio",Vector3.new(18,.08,17),at(34,.19,-4),Color3.fromRGB(240,216,224),Enum.Material.Limestone,nil,true)
		part(decor,"PatioBorder",Vector3.new(19,.05,18),at(34,.12,-4),lavender,Enum.Material.Slate)
		for _,pos in ipairs({Vector3.new(35,.24,-4),Vector3.new(-38,.24,-38)}) do
			place(asset("CafeSeating"),decor,"CafeTableAndChairs",cf*CFrame.new(pos),9,function(p)
				solidTint(p,p.Size.Y<.3 and cream or pink)
			end)
		end
		for _,x in ipairs({-43,43}) do
			place(asset("StreetLamp"),decor,"WarmCafeLamp",at(x,.15,-22),10,function(p) solidTint(p,lavender); p.Material=Enum.Material.Metal end)
			for _,z in ipairs({4,26,50}) do
				place(storage:FindFirstChild("FreeFlowerTemplate"),decor,"FlowerBorder",at(x<0 and -46 or 46,2.27,z),4)
			end
			for _,z in ipairs({10,20,35,45}) do
				place(grassMesh,decor,"GrassTuft",at(x<0 and -46 or 46,2.25,z),2.7,function(p) solidTint(p,Color3.fromRGB(139,185,149)) end)
			end
		end
		local display=place(asset("DisplayCase"),decor,"PastryDisplay",at(12,.15,-24),7,function(p)
			if p.Transparency<.2 then p.Color=cream; p.Material=Enum.Material.WoodPlanks
			else p.Color=Color3.fromRGB(205,234,240); p.Transparency=.65 end
		end)
		if display then
			place(storage:FindFirstChild("FreeHeartCakeTemplate"),decor,"DisplayCake",at(12,3.0,-24),2.5)
		end
		-- A tiny trimmed hedge near the cafe, not throughout the production field.
		for _,x in ipairs({-18,18}) do
			part(decor,"CafePlanter",Vector3.new(4,.8,4),at(x,.5,-54),lavender,Enum.Material.Slate)
			part(decor,"SoftHedge",Vector3.new(5,2.2,5),at(x,1.8,-54),Color3.fromRGB(146,187,154),Enum.Material.Grass,Enum.PartType.Ball)
			place(storage:FindFirstChild("FreeFlowerTemplate"),decor,"PlanterFlowers",at(x,2.2,-54),3)
		end
	end
	local Lighting=game:GetService("Lighting")
	Lighting.ExposureCompensation=-.25
	local atmosphere=Lighting:FindFirstChild("DessertAtmosphere") or Instance.new("Atmosphere")
	atmosphere.Name,atmosphere.Density,atmosphere.Offset="DessertAtmosphere",.2,.1
	atmosphere.Color,atmosphere.Decay=Color3.fromRGB(239,224,234),Color3.fromRGB(218,218,233)
	atmosphere.Haze,atmosphere.Glare,atmosphere.Parent=.6,.1,Lighting
	island:SetAttribute("LandscapeVersion",1)
	island:SetAttribute("MapVersion","9.0.0")
	print("[Landscape] PASS: six landscaped gardens, textured ground and cafe furniture; gameplay surfaces preserved")
end
return Landscape
]]></ProtectedString>
				<string name="ScriptGuid">{16ED624F-2EE3-4E13-841F-AF1674F88195}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">IslandLandscape</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">77ef6712a8ce0ba90adfea040000628b</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXD2DD512C049749CEAF5D0B3FA7D625F1">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Apply Classic Baseplate stud surfaces to ground and gameplay platforms.
local Style={}
local names={PlotFloor=true,SideFence=true,BackFence=true,FrontTrim=true,Entrance=true,PlotSpawn=true,
	MergeBoard=true,MainBelt=true,WalkwayBridge=true,Collector=true,CollectIncome=true,DessertCrate=true,
	BakeryTerrace=true,TeaPatio=true,PatioBorder=true,CafePlanter=true,CreamPath=true,PathEdging=true,
	MintIcingGround=true,VanillaPlaza=true,PlazaBorder=true}
local faces={{"TopSurface",Vector3.yAxis},{"BottomSurface",-Vector3.yAxis},
	{"RightSurface",Vector3.xAxis},{"LeftSurface",-Vector3.xAxis},
	{"BackSurface",Vector3.zAxis},{"FrontSurface",-Vector3.zAxis}}
local function studs(p)
	p.Material=Enum.Material.Plastic
	for _,face in ipairs(faces) do
		p[face[1]]=p.CFrame:VectorToWorldSpace(face[2]).Y>.98 and Enum.SurfaceType.Studs or Enum.SurfaceType.Smooth
	end
	p:SetAttribute("ClassicBaseplateSurface",true)
end
function Style.Apply(island)
	assert(not island:GetAttribute("ClassicPlotVersion"),"Classic style already applied")
	local layout=require(game.ReplicatedStorage.TycoonPlotLayout)
	for i=1,6 do
		local plot=island.PlayerPlots["Plot"..i]
		layout.BuildDessertSlots(plot)
		local decor=plot:FindFirstChild("CafeGardenDecor")
		if decor then for _,m in ipairs(decor:GetChildren()) do
			if m.Name=="FlowerBorder" or m.Name=="GrassTuft" then
				local cf=plot:GetPivot(); local localPos=cf:PointToObjectSpace(m:GetPivot().Position)
				if math.abs(localPos.X)<45 then
					m:PivotTo(m:GetPivot()+cf:VectorToWorldSpace(Vector3.new(localPos.X<0 and -3 or 3,0,0)))
				end
			end
		end end
	end
	for _,p in ipairs(island:GetDescendants()) do
		if p:IsA("Part") or p:IsA("SpawnLocation") then
			if names[p.Name] or p.Parent.Name=="PurchaseButtons" or p.Parent.Name=="MergeCells"
				or p.Parent.Name=="ProductionBeds" or p.Parent.Name=="PetSpawnPads" or p.Parent.Name=="PetPadFrames" then studs(p) end
		end
	end
	island:SetAttribute("ClassicPlotVersion",1)
	island:SetAttribute("MapVersion","10.0.0")
	print("[ClassicPlots] PASS: classic stud ground, 6x5 left + 6x5 right, 60 dessert slots per plot")
end
return Style
]]></ProtectedString>
				<string name="ScriptGuid">{129E6EA5-ADCA-41F3-AE9C-E32ABACE3B01}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">ClassicPlotStyle</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">16807e96ab3b03ad0ae0a2cb0000082f</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX87F952E07D3F4FDF9B283C2374534A17">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Configure real IDs only after creating products in this experience's Creator Dashboard.
local Config = {
	GiftInterval = 5 * 60 * 60,
	AFKInterval = 5 * 60 * 60,
	ProductionInterval = 3,
	PuddingCost = 5,
	Capacity = 60,
	CafeInterval = 2,
	CafeBaseRate = .10,
	CafeRateStep = .05,
	CafeMaxLevel = 18,
	CafeUpgradeBaseCost = 25,
	HotTimeSeconds = 15 * 60,
	HotTimeMultiplier = 2,
	MusicId = "rbxassetid://88115288095261",
	ClickSoundId = "rbxasset://sounds/volume_slider.ogg",
	DiscoverySoundId = "rbxassetid://158050602",
	Products = {
		Normal1 = {Id=0, Price=9, Count=1, Crate="Normal"},
		Normal10 = {Id=0, Price=79, Count=10, Crate="Normal"},
		Perk1 = {Id=0, Price=29, Count=1, Crate="Perk"},
		Perk10 = {Id=0, Price=229, Count=10, Crate="Perk"},
		HotTime = {Id=0, Price=19},
	},
	Passes = {
		Boost12 = {Id=0, Price=9, Multiplier=1.2, Name="1.2x Mini Desserts"},
		Boost15 = {Id=0, Price=49, Multiplier=1.5, Name="1.5x Mini Desserts"},
		Boost2 = {Id=0, Price=149, Multiplier=2, Name="2x Mini Desserts"},
		Boost5 = {Id=0, Price=499, Multiplier=5, Name="5x Mini Desserts"},
		AutoMerge = {Id=0, Price=299, Name="Auto Merge"},
		Magnet = {Id=0, Price=99, Name="Magnet"},
		Luck = {Id=0, Price=399, Name="2x Shiny Chance"},
	},
}
return Config
]]></ProtectedString>
				<string name="ScriptGuid">{CCFC68E6-BC63-4B75-B96F-480D512E7E75}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">TycoonConfig</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">24be45843d2709660ae0e4c00000082d</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXA5958F8E3743425E90CF975CC61C66F7">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Pure server rules. Quantities are logical counts; a Buy 1000 never builds 1000 models.
local Rules = {}
local Config=require(script.Parent.TycoonConfig)
local INTERVAL = Config.GiftInterval
function Rules.Key(tier, shiny) return tostring(tier)..(shiny and "s" or "n") end
function Rules.Decode(key) return tonumber(key:sub(1,-2)), key:sub(-1)=="s" end
function Rules.New(now)
	return {Version=2, Cash=25, Bag=0, Pending=0, CafeQueue=0, CafeLevel=0, Pets={["1n"]=1}, Index={["1n"]=true},
		NormalTokens=0, PerkTokens=0, PaidNormalTokens=0, PaidPerkTokens=0, NextGift=now+INTERVAL, AFKSeconds=0,
		Settings={Music=true, Effects=true, HideOthers=false}, Receipts={}, HotUntil=0}
end
function Rules.NormalizeCafe(data)
	data.CafeQueue=math.max(0,data.CafeQueue or 0)
	data.CafeLevel=math.clamp(math.floor(data.CafeLevel or 0),0,Config.CafeMaxLevel)
	data.Version=2
end
function Rules.CafeRate(data) return math.min(1,Config.CafeBaseRate+data.CafeLevel*Config.CafeRateStep) end
function Rules.CafeUpgradeCost(data) return Config.CafeUpgradeBaseCost*2^data.CafeLevel end
function Rules.Deposit(data)
	local amount=math.floor(data.Bag)
	data.Bag-=amount; data.CafeQueue+=amount
	return amount
end
function Rules.ConvertCafe(data,now)
	local units=math.min(data.CafeQueue,math.ceil(data.CafeQueue*Rules.CafeRate(data)))
	data.CafeQueue-=units
	local cash=units*(now<data.HotUntil and Config.HotTimeMultiplier or 1)
	data.Pending+=cash
	return units,cash
end
function Rules.UpgradeCafe(data)
	if data.CafeLevel>=Config.CafeMaxLevel then return false,"Converter is fully upgraded" end
	local cost=Rules.CafeUpgradeCost(data)
	if data.Cash<cost then return false,"Not enough cash for converter upgrade" end
	data.Cash-=cost; data.CafeLevel+=1; return true
end
function Rules.Add(data,tier,shiny,count,discoveries)
	local key=Rules.Key(tier,shiny)
	data.Pets[key]=(data.Pets[key] or 0)+(count or 1)
	if not data.Index[key] then
		data.Index[key]=true
		if discoveries then table.insert(discoveries,{Tier=tier,Shiny=shiny}) end
	end
end
function Rules.Merge(data,discoveries)
	for tier=1,29 do for _,shiny in ipairs({false,true}) do
		local key=Rules.Key(tier,shiny)
		local count=data.Pets[key] or 0
		local nextCount=math.floor(count/3)
		data.Pets[key]=count%3
		if nextCount>0 then Rules.Add(data,tier+1,shiny,nextCount,discoveries) end
	end end
end
function Rules.Count(data)
	local count=0; for _,n in pairs(data.Pets) do count+=n end; return count
end
function Rules.Highest(data)
	local highest=1
	for key,n in pairs(data.Pets) do if n>0 then local tier=Rules.Decode(key); highest=math.max(highest,tier) end end
	return highest
end
function Rules.Buy(data,count,rng,luck)
	if count~=1 and count~=10 and count~=100 and count~=1000 then return false,"Invalid quantity" end
	if data.Cash<count*Config.PuddingCost then return false,"Not enough cash" end
	local trial={Pets=table.clone(data.Pets), Index=table.clone(data.Index)}
	local discoveries={}
	for _=1,count do Rules.Add(trial,1,rng:NextNumber()<.01*(luck and 2 or 1),1,discoveries) end
	Rules.Merge(trial,discoveries)
	if Rules.Count(trial)>Config.Capacity then return false,"Plates are full. Merge desserts first." end
	data.Pets,data.Index=trial.Pets,trial.Index
	data.Cash-=count*Config.PuddingCost
	return true,discoveries
end
function Rules.Odds(highest,kind)
	local offsets=kind=="Perk" and {3,2,1,0} or {4,3,2,1}
	local weights=kind=="Perk" and {40,30,20,10} or {70,20,9,1}
	local odds={}
	for i,offset in ipairs(offsets) do
		local tier=math.max(1,highest-offset); odds[tier]=(odds[tier] or 0)+weights[i]
	end
	return odds
end
function Rules.Roll(data,kind,rng,luck,discoveries)
	local roll=rng:NextNumber()*100; local sum=0
	local odds=Rules.Odds(Rules.Highest(data),kind)
	for tier=1,30 do
		sum+=odds[tier] or 0
		if roll<sum then
			local shiny=rng:NextNumber()<(kind=="Perk" and .1 or .01)*(luck and 2 or 1)
			Rules.Add(data,tier,shiny,1,discoveries)
			return {Tier=tier,Shiny=shiny}
		end
	end
end
-- A missed offline interval does not accumulate unlimited gifts. Start the next 5h cycle now.
-- Both Premium and normal rewards share ONE deadline and are delivered atomically.
function Rules.Gift(data,now,premium)
	if now<data.NextGift then return false end
	data.NormalTokens+=1
	if premium then data.PerkTokens+=1 end
	data.NextGift=now+INTERVAL
	return true
end
function Rules.AFK(data,seconds)
	data.AFKSeconds+=seconds
	local earned=math.floor(data.AFKSeconds/Config.AFKInterval)
	data.AFKSeconds%=Config.AFKInterval
	data.NormalTokens+=earned
	return earned
end
return Rules
]]></ProtectedString>
				<string name="ScriptGuid">{6714B0EC-1C57-4A7D-8BA0-D7D6BF124B74}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">DessertRules</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">24be45843d2709660ae0e4c000000830</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBXFD79F9F0E5E34D03ADB6E59FF9567333">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Native, script-free dessert models shared by world pets and ViewportFrame previews.
local Catalog=require(script.Parent.DessertCatalog)
local Visuals={}
function Visuals.Build(tier,shiny)
	local m=Instance.new("Model"); m.Name=Catalog[tier].Name; m:SetAttribute("Tier",tier); m:SetAttribute("Shiny",shiny)
	local tint=shiny and Color3.fromRGB(255,220,115) or Color3.fromHSV((tier*.071+.07)%1,.24,1)
	if not shiny then
		if tier==2 then tint=Color3.fromRGB(255,239,198)
		elseif tier==3 then tint=Color3.fromRGB(255,170,197)
		elseif tier==23 then tint=Color3.fromRGB(255,249,235)
		elseif tier==27 then tint=Color3.fromRGB(224,184,154) end
	end
	local cream=Color3.fromRGB(255,247,231); local cocoa=Color3.fromRGB(133,82,72)
	local function p(name,size,pos,color,shape)
		local a=Instance.new("Part"); a.Name,a.Size,a.CFrame,a.Color=name,size,CFrame.new(pos),color
		a.Anchored,a.CanCollide,a.CanTouch,a.CanQuery=true,false,false,false
		a.Material=Enum.Material.SmoothPlastic; if shape then a.Shape=shape end; a.Parent=m; return a
	end
	local function disc(name,d,h,y,color)
		local a=p(name,Vector3.new(h,d,d),Vector3.new(0,y,0),color,Enum.PartType.Cylinder)
		a.CFrame*=CFrame.Angles(0,0,math.pi/2); return a
	end
	local body
	if tier==1 or tier==2 or tier==3 or tier==23 or tier==27 then
		body=disc("Body",2.7,1.7,1, tier==1 and not shiny and Color3.fromRGB(255,225,146) or tint)
		disc("Glaze",2.75,.18,1.9,tier==1 and cocoa or tint:Lerp(Color3.new(1,1,1),.4))
		p("Cream",Vector3.new(1,.65,1),Vector3.new(0,2.23,0),cream,Enum.PartType.Ball)
	elseif tier==6 then
		-- A ring assembled from curved-looking beads keeps a visible donut hole.
		for n=1,12 do local angle=n*math.pi/6
			local a=p("Donut",Vector3.new(.9,.7,.9),Vector3.new(math.cos(angle),.65,math.sin(angle)),tint,Enum.PartType.Ball)
			body=body or a
		end
	elseif tier==5 or tier==12 or tier==13 or tier==14 or tier==10 then
		body=disc("Body",2.9,.65,.6,shiny and tint or Color3.fromRGB(232,185,135))
		for n=1,6 do local a=n*math.pi/3; p("ChocolateChip",Vector3.new(.28,.15,.28),Vector3.new(math.cos(a)*.85,.98,math.sin(a)*.85),cocoa,Enum.PartType.Ball) end
	elseif tier==9 or tier==28 then
		local layers=tier==28 and 5 or 1
		for n=1,layers do
			disc("MacaronBottom",2.5-n*.13,.45,.4+(n-1)*.9,tint)
			disc("Filling",2.3-n*.13,.16,.69+(n-1)*.9,cream)
			body=disc("MacaronTop",2.5-n*.13,.45,.97+(n-1)*.9,tint)
		end
	elseif tier==26 then
		body=p("PotionBottle",Vector3.new(2,2,2),Vector3.new(0,1.2,0),tint,Enum.PartType.Ball)
		disc("BottleNeck",.8,.65,2.35,Color3.fromRGB(223,234,255))
		disc("Cork",.9,.3,2.8,Color3.fromRGB(220,176,140))
		p("Ribbon",Vector3.new(1.3,.3,.3),Vector3.new(0,2.3,-.5),cream)
	elseif tier==25 then
		body=disc("Candy",2.6,.65,1.2,tint)
		p("CandyWrapper",Vector3.new(3.4,.25,.65),Vector3.new(0,1.2,0),cream)
	elseif tier==16 or tier==19 then
		body=disc("Cup",2,1.7,1,Color3.fromRGB(206,227,248))
		for n=1,3 do p("Scoop",Vector3.new(1.5,1.3,1.5),Vector3.new((n-2)*.6,1.9+(n%2)*.45,0),tint,Enum.PartType.Ball) end
	elseif tier==29 then
		body=p("Castle",Vector3.new(2.2,2,1.7),Vector3.new(0,1.2,0),tint)
		for _,x in ipairs({-1.2,1.2}) do
			p("Tower",Vector3.new(.9,2.7,.9),Vector3.new(x,1.4,0),cream)
			p("SugarRoof",Vector3.new(1.2,1.2,1.2),Vector3.new(x,3,0),tint,Enum.PartType.Ball)
		end
	elseif tier==30 then
		body=p("Dragon",Vector3.new(2.4,2.3,2.2),Vector3.new(0,1.6,0),tint,Enum.PartType.Ball)
		for _,x in ipairs({-1,1}) do
			p("Wing",Vector3.new(1.8,.35,1.8),Vector3.new(x*1.6,1.6,.3),cream)
			p("Horn",Vector3.new(.45,1.1,.45),Vector3.new(x*.65,3,-.2),Color3.fromRGB(255,215,129))
		end
		p("Tail",Vector3.new(.8,.8,2),Vector3.new(0,.9,1.6),tint,Enum.PartType.Ball)
	else
		body=p("Body",Vector3.new(2.6,1.5,2),Vector3.new(0,1,0),(tier==4 or tier==21) and cocoa or tint)
		p("Filling",Vector3.new(2.65,.25,2.05),Vector3.new(0,1.25,0),cream)
		p("Icing",Vector3.new(2.7,.25,2.1),Vector3.new(0,1.88,0),tint)
		p("Berry",Vector3.new(.5,.5,.5),Vector3.new(.6,2.2,0),Color3.fromRGB(239,131,163),Enum.PartType.Ball)
	end
	for _,x in ipairs({-.48,.48}) do
		p("Eye",Vector3.new(.17,.24,.12),Vector3.new(x,1.1,-1.32),Color3.fromRGB(73,55,68),Enum.PartType.Ball)
		p("Blush",Vector3.new(.35,.16,.08),Vector3.new(x*1.55,.88,-1.32),Color3.fromRGB(255,167,186),Enum.PartType.Ball)
	end
	p("Smile",Vector3.new(.19,.09,.12),Vector3.new(0,.86,-1.34),cocoa)
	-- Cylinder parts are rotated locally; keep the MODEL pivot upright at the origin.
	body.PivotOffset=body.CFrame:Inverse(); m.PrimaryPart=body
	if shiny then
		local sparkle=Instance.new("ParticleEmitter"); sparkle.Texture="rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Rate=3; sparkle.Lifetime=NumberRange.new(.8,1.3); sparkle.Speed=NumberRange.new(.3,.8)
		sparkle.Color=ColorSequence.new(Color3.fromRGB(255,225,129)); sparkle.Size=NumberSequence.new(.18); sparkle.Parent=body
	end
	return m
end
return Visuals
]]></ProtectedString>
				<string name="ScriptGuid">{5512354B-5F7B-4310-A72E-F8812644BF31}</string>
