		<Item class="ModuleScript" referent="RBXD620BAAB10724D1596A9575E6D44DA2E">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Shared by the fresh map generator and the edit-mode layout migration.
-- Thirty invisible placement markers are gameplay data, not visible floor tiles.
local Layout = { Radius = 150, Width = 96, Depth = 120, IslandDiameter = 460 }
local pink = Color3.fromRGB(255,193,218)
local lavender = Color3.fromRGB(211,198,248)
local mint = Color3.fromRGB(185,235,211)
local cream = Color3.fromRGB(255,248,235)
local cocoa = Color3.fromRGB(112,76,91)
local function part(parent,name,size,cf,color,solid)
	local p=Instance.new("Part")
	p.Name,p.Size,p.CFrame,p.Color=name,size,cf,color
	p.Anchored,p.CanCollide,p.CanTouch=true,solid~=false,false
	p.Material=Enum.Material.SmoothPlastic
	p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
	p.Parent=parent
	return p
end
local function model(parent,name)
	local m=Instance.new("Model"); m.Name,m.Parent=name,parent; return m
end
local function label(p,name,text,width)
	local gui=Instance.new("BillboardGui")
	gui.Name,gui.Size,gui.StudsOffset,gui.MaxDistance=name,UDim2.new(width or 8,0,1.5,0),Vector3.new(0,2.5,0),55
	gui.Adornee,gui.Parent=p,p
	local t=Instance.new("TextLabel")
	t.Name,t.Size,t.BackgroundTransparency,t.TextScaled="CollectionLabel",UDim2.fromScale(1,1),1,true
	t.Text,t.Font,t.TextColor3=text,Enum.Font.GothamBold,cocoa; t.Parent=gui
	return gui
end
function Layout.Apply(island)
	assert(not island:GetAttribute("CleanPlotLayoutVersion"),"Clean layout already applied")
	local hub=island.CentralHub
	local center=hub.CentralShop:GetPivot().Position
	local template=game.ServerStorage:FindFirstChild("CentralCafeTemplate")
	if not hub.CentralShop:FindFirstChild("CenterAnchor") then
		if not template then
			template=model(game.ServerStorage,"CentralCafeTemplate")
			hub.CentralShop.Parent=template
			if hub:FindFirstChild("GiantPudding") then hub.GiantPudding.Parent=template end
		else
			hub.CentralShop:Destroy()
			if hub:FindFirstChild("GiantPudding") then hub.GiantPudding:Destroy() end
		end
		local anchorModel=model(hub,"CentralShop")
		local anchor=part(anchorModel,"CenterAnchor",Vector3.new(.2,.2,.2),CFrame.new(center),cream,false)
		anchor.Transparency,anchor.CanQuery=1,false; anchorModel.PrimaryPart=anchor
		if not hub:FindFirstChild("CentralDisplay") then model(hub,"CentralDisplay") end
	end
	-- Expand the circular island once, without scaling the cafes or tree meshes.
	local ground=island.FloatingIsland.MintIcingGround
	local factor=Layout.IslandDiameter/ground.Size.Y
	for _,p in ipairs(island.FloatingIsland:GetDescendants()) do
		if p:IsA("BasePart") then
			local pos=p.Position; p.CFrame=CFrame.new(pos.X*factor,pos.Y,pos.Z*factor)*p.CFrame.Rotation
			if p.Shape==Enum.PartType.Cylinder then p.Size=Vector3.new(p.Size.X,p.Size.Y*factor,p.Size.Z*factor)
			else p.Size=Vector3.new(p.Size.X*factor,p.Size.Y,p.Size.Z*factor) end
		end
	end
	for _,groupName in ipairs({"CandyGarden","SakuraGarden"}) do
		local garden=island:FindFirstChild(groupName)
		if garden then for _,item in ipairs(garden:GetChildren()) do
			if item:IsA("PVInstance") then
				local old=item:GetPivot(); local radial=Vector3.new(old.X,0,old.Z)
				if radial.Magnitude>100 then item:PivotTo(old+radial.Unit*(radial.Magnitude*(factor-1))) end
			end
		end end
	end
	if island:FindFirstChild("SugarPaths") then island.SugarPaths:ClearAllChildren() end
	local archive=Instance.new("Folder"); archive.Name,archive.Parent="PreviousPlotDecor",game.ServerStorage
	for i=1,6 do
		local plot=island.PlayerPlots["Plot"..i]
		local old=plot:GetPivot(); local angle=(i-1)*math.pi/3
		local position=Vector3.new(center.X+math.sin(angle)*Layout.Radius,old.Y,center.Z+math.cos(angle)*Layout.Radius)
		local cf=CFrame.lookAt(position,Vector3.new(center.X,old.Y,center.Z))
		plot:PivotTo(cf)
		local area=plot:FindFirstChild("PersonalShopArea") or model(plot,"PersonalShopArea")
		local cafe=area:FindFirstChild("DessertCafe")
		if not cafe then cafe=template:Clone(); cafe.Name,cafe.Parent="DessertCafe",area; cafe.CentralShop.Name="CafeBuilding" end
		local owner=cafe:FindFirstChild("OwnerSign",true)
		local box,size=cafe:GetBoundingBox()
		cafe:PivotTo(cf*CFrame.new(0,.15+size.Y/2,-42)*box:ToObjectSpace(cafe:GetPivot()))
		if not owner then owner=label(cafe.CafeBuilding.Roof,"OwnerSign","Available Cafe",18); owner.CollectionLabel.Name="OwnerLabel" end
		owner.StudsOffset=Vector3.new(0,15,0)
		for _,child in ipairs(plot:GetChildren()) do
			if child~=area then
				if child.Name=="GardenDecor" or child.Name:match("DisplayMascot") then child.Parent=archive
				else child:Destroy() end
			end
		end
		for _,child in ipairs(area:GetChildren()) do if child~=cafe then child:Destroy() end end
		local function at(x,y,z) return cf*CFrame.new(x,y,z) end
		local function p(parent,name,size,x,y,z,color,solid) return part(parent,name,size,at(x,y,z),color,solid) end
		-- One uninterrupted smooth base, four low edge trims, no stud/grid floor.
		local floor=p(plot,"PlotFloor",Vector3.new(96,1,120),0,-.35,0,cream)
		plot.PrimaryPart=floor
		-- Keep the pivot at the original gameplay origin rather than the floor's center.
		floor.PivotOffset=CFrame.new(0,.35,0)
		for _,x in ipairs({-47.5,47.5}) do p(plot,"SideFence",Vector3.new(1,.6,120),x,.35,0,i%2==0 and lavender or pink) end
		p(plot,"BackFence",Vector3.new(94,.6,1),0,.35,59.5,lavender)
		p(plot,"FrontTrim",Vector3.new(94,.25,1),0,.27,-59.5,pink)
		p(plot,"Entrance",Vector3.new(10,.1,5),30,.2,-57,mint)
		p(plot,"PlotSpawn",Vector3.new(8,.1,6),30,.2,-51,mint)
		local board=p(plot,"MergeBoard",Vector3.new(18,.6,18),-27,.45,-4,lavender)
		board:SetAttribute("RequiredCount",3); label(board,"MergeSign","Merge 3 into 1",10)
		local cells=model(plot,"MergeCells")
		for row=1,3 do for col=1,3 do
			p(cells,"Cell"..((row-1)*3+col),Vector3.new(4.8,.05,4.8),-27+(col-2)*5.3,.78,-4+(row-2)*5.3,cream,false)
		end end
		local buttons=model(plot,"PurchaseButtons")
		for n,count in ipairs({1,5,25,100}) do
			local x=n<=2 and -25 or 25; local z=(n==1 or n==3) and -32 or -22
			local pad=p(buttons,"Buy"..count,Vector3.new(9,.3,6),x,.3,z,lavender)
			label(pad,"BuySign","Buy "..count.." ($"..tostring(count*5)..")",9)
		end
		label(p(area,"CollectIncome",Vector3.new(9,.3,6),-25,.3,-47,mint),"IncomeSign","Collect Earnings",9)
		local crate=p(area,"DessertCrate",Vector3.new(9,.3,6),25,.3,-47,pink)
		crate:SetAttribute("GameplayConnected",false); label(crate,"CrateSign","Dessert Crate - Coming Soon",10)
		-- Two broad meadows, with no visible rows or individual pet pads.
		local beds=model(plot,"ProductionBeds")
		for _,side in ipairs({-1,1}) do
			p(beds,side<0 and "LeftMeadow" or "RightMeadow",Vector3.new(40,2,56),side*24,1.25,27,mint)
			p(beds,"MeadowStep",Vector3.new(40,1,3),side*24,.65,-2,cream)
		end
		local pads=model(plot,"PetSpawnPads")
		for slot=1,30 do
			local row=math.ceil(slot/6); local column=(slot-1)%6+1
			local x=({-36,-24,-12,12,24,36})[column]; local z=4+(row-1)*11
			local pad=p(pads,"PetPad"..slot,Vector3.new(1,.1,1),x,2.32,z,mint,false)
			pad.Transparency,pad.CanQuery=1,false
			pad:SetAttribute("SlotIndex",slot); pad:SetAttribute("PlotId",i); pad:SetAttribute("DropLaneZ",z)
		end
		local belts=model(plot,"Conveyors")
		local main=p(belts,"MainBelt",Vector3.new(8,.25,74),0,.4,18,Color3.fromRGB(175,159,188))
		main:SetAttribute("FlowDirection","TowardCafe")
		-- Wide bridges make both meadows accessible; rolling goods pass underneath.
		for _,z in ipairs({0,26,52}) do p(belts,"WalkwayBridge",Vector3.new(12,.3,4),0,2.1,z,cream) end
		local collector=p(belts,"Collector",Vector3.new(8,.8,3),0,.6,-20,mint)
		label(collector,"CollectorSign","Collect $0",9)
		plot:SetAttribute("LayoutStyle","CleanTycoonBase")
		plot:SetAttribute("CollectorZ",-20)
		plot:SetAttribute("ProductionBedCount",2)
		plot:SetAttribute("OwnerUserId",0)
		local pathCenter=(Vector3.new(center.X,position.Y,center.Z)+at(30,0,-60).Position)/2
		local endpoint=at(30,0,-60).Position
		part(island.SugarPaths,"CreamPath",Vector3.new(14,.3,(endpoint-Vector3.new(center.X,position.Y,center.Z)).Magnitude),CFrame.lookAt(pathCenter,endpoint)*CFrame.new(0,-.55,0),cream)
	end
	island:SetAttribute("CleanPlotLayoutVersion",1)
	island:SetAttribute("ConveyorLayoutVersion",2)
	island:SetAttribute("MapVersion","8.0.0")
	island:SetAttribute("PlotRadius",Layout.Radius)
	print("[CleanPlots] Built six 96x120 bases, side merge boards, open meadows and wide conveyors")
end
return Layout
]]></ProtectedString>
				<string name="ScriptGuid">{4B7E26F0-925C-4EC4-884E-92B94810D72D}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">TycoonPlotLayout</string>
				<BinaryString name="SerializedOverrides"></BinaryString>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">77ef6712a8ce0ba90adfea0400004ae5</UniqueId>
			</Properties>
		</Item>
		<Item class="ModuleScript" referent="RBX402AC81C37144AA4ADEB6751737A409B">
			<Properties>
				<Content name="LinkedSource"><null></null></Content>
				<ProtectedString name="Source"><![CDATA[-- Large ground surfaces and pocket gardens; no new gameplay scripts in imported props.
local Landscape={}
local cream=Color3.fromRGB(249,239,221)
local pink=Color3.fromRGB(245,190,211)
local lavender=Color3.fromRGB(204,188,228)
local grass=Color3.fromRGB(180,238,191)
local function group(parent,name)
	local m=Instance.new("Model"); m.Name,m.Parent=name,parent; return m
end
local function part(parent,name,size,cf,color,material,shape,solid)
	local p=Instance.new("Part")
	p.Name,p.Size,p.CFrame,p.Color=name,size,cf,color
	p.Material=material or Enum.Material.SmoothPlastic
	p.Shape=shape or Enum.PartType.Block
	p.Anchored,p.CanCollide,p.CanTouch=true,solid==true,false
	p.TopSurface,p.BottomSurface=Enum.SurfaceType.Smooth,Enum.SurfaceType.Smooth
	p.Parent=parent; return p
end
local function place(source,parent,name,cf,maxSize,recolor)
	if not source then return end
	local m=group(nil,name)
	local copy=source:Clone(); copy.Parent=m
	local box,size=m:GetBoundingBox()
	m:ScaleTo(m:GetScale()*maxSize/math.max(size.X,size.Y,size.Z))
	box,size=m:GetBoundingBox()
	m:PivotTo(cf*CFrame.new(0,size.Y/2,0)*box:ToObjectSpace(m:GetPivot()))
	for _,p in ipairs(m:GetDescendants()) do
		assert(not p:IsA("LuaSourceContainer"),"Imported decoration contains code")
		if p:IsA("BasePart") then
			p.Anchored,p.CanCollide,p.CanTouch,p.CanQuery=true,false,false,false
			if recolor then recolor(p) end
		elseif p:IsA("Light") then p.Color=Color3.fromRGB(255,229,196); p.Brightness=.35; p.Range=8
		elseif p:IsA("Beam") then p.Enabled=false end
	end
	m:SetAttribute("DecorationOnly",true)
	m.Parent=parent; return m,size
end
local function solidTint(p,color)
	if p:IsA("MeshPart") then p.TextureID="" end
	for _,d in ipairs(p:GetChildren()) do
		if d:IsA("SpecialMesh") then d.TextureId=""
		elseif d:IsA("SurfaceAppearance") or d:IsA("Decal") or d:IsA("Texture") then d:Destroy() end
	end
	p.Color=color; p.Material=Enum.Material.SmoothPlastic
end
function Landscape.Apply(island)
	assert(not island:GetAttribute("LandscapeVersion"),"Landscape already applied")
	local storage=game.ServerStorage
	local assets=storage:FindFirstChild("FreeEnvironmentAssets")
	local function asset(name) return assets and assets:FindFirstChild(name) end
	local meadow=asset("MeadowPack")
	local grassMesh=meadow and meadow:FindFirstChild("Grass",true)
	local rockMesh=meadow and meadow:FindFirstChild("Rock",true)
	local terrainTop=meadow and meadow:FindFirstChild("Terrain Top",true)
	local nature=asset("NaturePack")
	local roundRock=nature and nature:FindFirstChild("Meshes/lowpolypack_Icosphere",true)
	local world=group(island,"Landscape")
	local ground=island.FloatingIsland.MintIcingGround
	ground.Color,ground.Material=grass,Enum.Material.Grass
	for _,p in ipairs(island.FloatingIsland:GetChildren()) do
		if p.Name=="ScallopedIcing" then p.Color=grass; p.Material=Enum.Material.Grass end
	end
	island.FloatingIsland.PinkCakeLayer.Material=Enum.Material.Sandstone
	island.FloatingIsland.PinkCakeLayer.Color=Color3.fromRGB(227,183,195)
	island.FloatingIsland.LavenderCakeLayer.Material=Enum.Material.Slate
	island.FloatingIsland.LavenderCakeLayer.Color=Color3.fromRGB(197,181,207)
	for _,path in ipairs(island.SugarPaths:GetChildren()) do
		path.Material,path.Color=Enum.Material.Limestone,cream
		for _,side in ipairs({-1,1}) do
			part(world,"PathEdging",Vector3.new(1,.2,path.Size.Z),path.CFrame*CFrame.new(side*(path.Size.X/2+.6),.12,0),Color3.fromRGB(219,207,195),Enum.Material.Slate)
		end
	end
	-- Sculpted ellipsoid hills sit only between plots; the central display remains empty.
	local center=island.CentralHub.CentralShop:GetPivot().Position
	local gardens=group(world,"PocketGardens")
	for i=1,6 do
		local angle=(i-.5)*math.pi/3
		local origin=Vector3.new(center.X+math.sin(angle)*160,0,center.Z+math.cos(angle)*160)
		local cf=CFrame.new(origin)*CFrame.Angles(0,angle,0)
		local garden=group(gardens,"Garden"..i)
		local hill=part(garden,"SoftGrassHill",Vector3.new(42,10,46),cf*CFrame.new(0,-3,0),grass,Enum.Material.Grass,Enum.PartType.Ball,true)
		hill:SetAttribute("LandscapeGround",true)
		part(garden,"SmallGrassHill",Vector3.new(26,6,25),cf*CFrame.new(5,-1.8,8),Color3.fromRGB(219,240,210),Enum.Material.Grass,Enum.PartType.Ball,true)
		place(storage:FindFirstChild("FreeSakuraTemplate"),garden,"BlossomTree",cf*CFrame.new(0,2,0),18)
		-- A low-poly ground mesh rounds out the small garden's shape.
		place(terrainTop,garden,"LowPolyGrassBank",cf*CFrame.new(-3,-1.2,-4),24,function(p) solidTint(p,grass) end)
		for n=1,5 do
			local a=n*math.pi*2/5
			local rock=place(n%2==0 and rockMesh or roundRock,garden,"PastelRock",cf*CFrame.new(math.sin(a)*18,0,math.cos(a)*17),3+n%3,function(p) solidTint(p,n%2==0 and lavender or cream) end)
			if rock then rock:SetAttribute("SourceAssetId",n%2==0 and 18723685255 or 14299404156) end
			place(storage:FindFirstChild("FreeFlowerTemplate"),garden,"FlowerCluster",cf*CFrame.new(math.sin(a)*14,1.1,math.cos(a)*13),4)
		end
		place(storage:FindFirstChild("FreeBenchTemplate"),garden,"GardenBench",cf*CFrame.new(0,0,-24),9,function(p) p.Material=Enum.Material.WoodPlanks; p.Color=cream end)
	end
	for i=1,6 do
		local plot=island.PlayerPlots["Plot"..i]; local cf=plot:GetPivot()
		local decor=group(plot,"CafeGardenDecor"); decor:SetAttribute("PlotId",i)
		local function at(x,y,z) return cf*CFrame.new(x,y,z) end
		plot.PlotFloor.Material,plot.PlotFloor.Color=Enum.Material.Limestone,cream
		for _,p in ipairs(plot.ProductionBeds:GetChildren()) do
			if p.Name:match("Meadow$") then p.Material,p.Color=Enum.Material.Grass,Color3.fromRGB(190,245,205) end
		end
		-- Broad material zones define the cafe, pedestrian forecourt and grassy field.
		part(decor,"BakeryTerrace",Vector3.new(32,.08,27),at(0,.19,-42),Color3.fromRGB(239,211,205),Enum.Material.WoodPlanks,nil,true)
		part(decor,"TeaPatio",Vector3.new(18,.08,17),at(34,.19,-4),Color3.fromRGB(240,216,224),Enum.Material.Limestone,nil,true)
		part(decor,"PatioBorder",Vector3.new(19,.05,18),at(34,.12,-4),lavender,Enum.Material.Slate)
		for _,pos in ipairs({Vector3.new(35,.24,-4),Vector3.new(-38,.24,-38)}) do
			place(asset("CafeSeating"),decor,"CafeTableAndChairs",cf*CFrame.new(pos),9,function(p)
				solidTint(p,p.Size.Y<.3 and cream or pink)
			end)
		end
		for _,x in ipairs({-43,43}) do
			place(asset("StreetLamp"),decor,"WarmCafeLamp",at(x,.15,-22),10,function(p) solidTint(p,lavender); p.Material=Enum.Material.Metal end)
			for _,z in ipairs({4,26,50}) do
				place(storage:FindFirstChild("FreeFlowerTemplate"),decor,"FlowerBorder",at(x,2.27,z),4)
			end
			for _,z in ipairs({10,20,35,45}) do
				place(grassMesh,decor,"GrassTuft",at(x,2.25,z),2.7,function(p) solidTint(p,Color3.fromRGB(139,185,149)) end)
			end
		end
		local display=place(asset("DisplayCase"),decor,"PastryDisplay",at(12,.15,-24),7,function(p)
			if p.Transparency<.2 then p.Color=cream; p.Material=Enum.Material.WoodPlanks
			else p.Color=Color3.fromRGB(205,234,240); p.Transparency=.65 end
		end)
		if display then
			place(storage:FindFirstChild("FreeHeartCakeTemplate"),decor,"DisplayCake",at(12,3.0,-24),2.5)
		end
		-- A tiny trimmed hedge near the cafe, not throughout the production field.
		for _,x in ipairs({-18,18}) do
			part(decor,"CafePlanter",Vector3.new(4,.8,4),at(x,.5,-54),lavender,Enum.Material.Slate)
			part(decor,"SoftHedge",Vector3.new(5,2.2,5),at(x,1.8,-54),Color3.fromRGB(146,187,154),Enum.Material.Grass,Enum.PartType.Ball)
			place(storage:FindFirstChild("FreeFlowerTemplate"),decor,"PlanterFlowers",at(x,2.2,-54),3)
		end
	end
	local Lighting=game:GetService("Lighting")
	Lighting.ExposureCompensation=-.25
	local atmosphere=Lighting:FindFirstChild("DessertAtmosphere") or Instance.new("Atmosphere")
	atmosphere.Name,atmosphere.Density,atmosphere.Offset="DessertAtmosphere",.2,.1
	atmosphere.Color,atmosphere.Decay=Color3.fromRGB(239,224,234),Color3.fromRGB(218,218,233)
	atmosphere.Haze,atmosphere.Glare,atmosphere.Parent=.6,.1,Lighting
	island:SetAttribute("LandscapeVersion",1)
	island:SetAttribute("MapVersion","9.0.0")
	print("[Landscape] PASS: six landscaped gardens, textured ground and cafe furniture; gameplay surfaces preserved")
end
return Landscape
]]></ProtectedString>
